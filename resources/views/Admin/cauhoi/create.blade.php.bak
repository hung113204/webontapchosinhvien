    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let editors = {};
        let answerCount = 0;
        let previewData = null;
        let tempFile = null;

        // Cấu hình MathJax
        window.MathJax = {
            tex: {
                inlineMath: [
                    ['$', '$'],
                    ['\\(', '\\)']
                ],
                displayMath: [
                    ['$$', '$$'],
                    ['\\[', '\\]']
                ]
            },
            startup: {
                ready: () => {
                    MathJax.startup.defaultReady();
                    MathJax.startup.promise.then(() => {
                        console.log('MathJax is ready');
                    });
                }
            }
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.min.js"></script>

    <script>

        // Hàm xử lý LaTeX content
        function processLatexContent(content) {
            if (!content) return content;
            
            // Wrap các pattern LaTeX phổ biến
            let processed = content;
            
            // Xử lý \begin{cases}...\end{cases}
            processed = processed.replace(/\\begin\{cases\}([\s\S]*?)\\end\{cases\}/g, 
                '\\[\\begin{cases}$1\\end{cases}\\]');
            
            // Xử lý các dấu \\ trong LaTeX (line break)
            processed = processed.replace(/\\\\/g, '\\\\');
            
            return processed;
        }

        // Cấu hình CKEditor với xử lý paste
        function initEditors() {
            const editorConfig = {
                toolbar: [
                    'heading', '|',
                    'bold', 'italic', '|',
                    'link', 'insertTable', '|',
                    'bulletedList', 'numberedList', '|',
                    'undo', 'redo'
                ],
                language: 'vi',
                // Cho phép giữ lại HTML khi paste
                htmlSupport: {
                    allow: [
                        {
                            name: /.*/,
                            attributes: true,
                            classes: true,
                            styles: true
                        }
                    ]
                }
            };

            // Editor câu hỏi chính
            ClassicEditor.create(document.querySelector('#editor-cau-hoi'), editorConfig)
                .then(editor => {
                    editors['main-question'] = editor;
                    
                    // Xử lý khi paste vào editor
                    editor.editing.view.document.on('clipboardInput', (evt, data) => {
                        const content = data.dataTransfer.getData('text/html') || data.dataTransfer.getData('text/plain');
                        if (content) {
                            const processed = processLatexContent(content);
                            data.dataTransfer.setData('text/html', processed);
                        }
                    });
                    
                    // Render MathJax sau khi editor thay đổi
                    editor.model.document.on('change:data', () => {
                        setTimeout(() => {
                            if (window.MathJax && window.MathJax.typesetPromise) {
                                MathJax.typesetPromise();
                            }
                        }, 100);
                    });
                })
                .catch(error => {
                    console.error('Error initializing main question editor:', error);
                });

            // Editor giải thích
            ClassicEditor.create(document.querySelector('#editor-giai-thich'), editorConfig)
                .then(editor => {
                    editors['main-explain'] = editor;
                    
                    editor.editing.view.document.on('clipboardInput', (evt, data) => {
                        const content = data.dataTransfer.getData('text/html') || data.dataTransfer.getData('text/plain');
                        if (content) {
                            const processed = processLatexContent(content);
                            data.dataTransfer.setData('text/html', processed);
                        }
                    });
                    
                    editor.model.document.on('change:data', () => {
                        setTimeout(() => {
                            if (window.MathJax && window.MathJax.typesetPromise) {
                                MathJax.typesetPromise();
                            }
                        }, 100);
                    });
                })
                .catch(error => {
                    console.error('Error initializing explain editor:', error);
                });
        }

        function addAnswer() {
            answerCount++;
            const index = answerCount - 1;
            const id = `ans_${answerCount}`;
            const html = `
            <div class="answer-item" id="container_${id}">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 500; font-size: 14px; color: #475569;">
                        <input type="radio" name="dap_an_dung" value="${index}" ${index === 0 ? 'checked' : ''} style="accent-color: #4f46e5;"> Đáp án đúng ${answerCount}
                    </label>
                    <button type="button" class="btn-delete-ans" onclick="removeAnswer('${id}')">Xóa</button>
                </div>
                <textarea name="dap_ans[${index}][noi_dung]" id="editor_${id}"></textarea>
            </div>`;
            
            document.getElementById('answers-container').insertAdjacentHTML('beforeend', html);
            
            const editorConfig = {
                toolbar: ['bold', 'italic', '|', 'undo', 'redo'],
                language: 'vi',
                htmlSupport: {
                    allow: [
                        {
                            name: /.*/,
                            attributes: true,
                            classes: true,
                            styles: true
                        }
                    ]
                }
            };
            
            ClassicEditor.create(document.querySelector(`#editor_${id}`), editorConfig)
                .then(editor => {
                    editors[id] = editor;
                    
                    // Xử lý paste cho editor đáp án
                    editor.editing.view.document.on('clipboardInput', (evt, data) => {
                        const content = data.dataTransfer.getData('text/html') || data.dataTransfer.getData('text/plain');
                        if (content) {
                            const processed = processLatexContent(content);
                            data.dataTransfer.setData('text/html', processed);
                        }
                    });
                    
                    editor.model.document.on('change:data', () => {
                        setTimeout(() => {
                            if (window.MathJax && window.MathJax.typesetPromise) {
                                MathJax.typesetPromise();
                            }
                        }, 100);
                    });
                })
                .catch(error => {
                    console.error(`Error initializing answer editor ${id}:`, error);
                });
        }

        function removeAnswer(id) {
            if (editors[id]) {
                editors[id].destroy().then(() => {
                    delete editors[id];
                    document.getElementById(`container_${id}`).remove();
                });
            } else {
                document.getElementById(`container_${id}`).remove();
            }
        }

        document.getElementById('question-form').addEventListener('submit', function(e) {
            // Lưu nội dung từ editor vào hidden input
            if (editors['main-question']) {
                let content = editors['main-question'].getData();
                content = processLatexContent(content);
                document.getElementsByName('noi_dung')[0].value = content;
            }
            
            if (editors['main-explain']) {
                let content = editors['main-explain'].getData();
                content = processLatexContent(content);
                document.getElementsByName('giai_thich')[0].value = content;
            }

            document.querySelectorAll('textarea[name^="dap_ans"]').forEach((textarea) => {
                const id = textarea.id;
                if (editors[id]) {
                    let content = editors[id].getData();
                    content = processLatexContent(content);
                    textarea.value = content;
                }
            });
        });

        // Lọc chương theo môn học - Tab thủ công
        document.getElementById('mon_hoc_id').addEventListener('change', function() {
            const monId = this.value;
            const chuongSelect = document.getElementById('chuong_hoc_id');
            chuongSelect.querySelectorAll('option').forEach(opt => {
                if (opt.value === "") opt.style.display = "block";
                else opt.style.display = opt.getAttribute('data-mon') == monId ? "block" : "none";
            });
            chuongSelect.value = "";
        });

        // Lọc chương theo môn học - Tab file
        document.getElementById('file_mon_hoc_id').addEventListener('change', function() {
            const monId = this.value;
            const chuongSelect = document.getElementById('file_chuong_hoc_id');
            chuongSelect.querySelectorAll('option').forEach(opt => {
                if (opt.value === "") opt.style.display = "block";
                else opt.style.display = opt.getAttribute('data-mon') == monId ? "block" : "none";
            });
            chuongSelect.value = "";
        });

        // Custom file input label
        document.getElementById('wordFile').addEventListener('change', function() {
            const fileName = this.files[0]?.name || 'Click để chọn file Word (.docx)';
            document.getElementById('fileLabel').textContent = fileName;
        });

        // Preview file Word
        document.getElementById('btnPreview').addEventListener('click', async function() {
            const form = document.getElementById('uploadForm');
            const formData = new FormData(form);

            // Kiểm tra required fields
            if (!formData.get('chuong_hoc_id')) {
                alert('Vui lòng chọn chương học');
                return;
            }

            if (!formData.get('file') || formData.get('file').size === 0) {
                alert('Vui lòng chọn file Word');
                return;
            }

            // Show loading
            Swal.fire({
                title: 'Đang đọc file...',
                text: 'Vui lòng đợi',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const response = await fetch('{{ route('admin.cauhoi.import.preview.word') }}', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-TOKEN': '{{ csrf_token() }}',
                        'Accept': 'application/json',
                    },
                    body: formData
                });

                const responseText = await response.text();
                
                if (responseText.includes('<!DOCTYPE') || responseText.includes('<html') || response.status === 404) {
                    throw new Error(`Server returned HTML instead of JSON. Status: ${response.status}`);
                }

                const data = JSON.parse(responseText);
                Swal.close();

                if (data.success) {
                    previewData = data.data;
                    tempFile = data.data.temp_file;
                    displayPreview(data.data.questions);
                } else {
                    Swal.fire('Lỗi', data.message || 'Có lỗi xảy ra', 'error');
                }
            } catch (error) {
                Swal.close();
                console.error('Fetch error:', error);
                Swal.fire({
                    title: 'Lỗi kết nối',
                    html: `
                        <div style="text-align: left; font-family: monospace; font-size: 12px;">
                            <strong>Error:</strong> ${error.message}<br><br>
                            <strong>Possible causes:</strong><br>
                            1. Route not found (404)<br>
                            2. Server error (500)<br>
                            3. CSRF token mismatch<br>
                            4. File too large<br>
                        </div>
                    `,
                    icon: 'error'
                });
            }
        });

        // Display preview với MathJax rendering
        function displayPreview(questions) {
            document.getElementById('totalQuestions').textContent = questions.length;

            let html = '';
            questions.forEach((q, index) => {
                const correctAnswer = q.answers.find(a => a.is_correct);
                const correctLetter = correctAnswer ? String.fromCharCode(65 + correctAnswer.index) : 'A';

                html += `
                    <div class="question-preview selected" data-index="${index}">
                        <div class="question-header">
                            <input type="checkbox" class="question-checkbox" data-index="${index}" checked>
                            <span class="question-number">${q.question_number || (index + 1)}</span>
                            <div class="question-content">${q.noi_dung}</div>
                        </div>
                        
                        ${q.answers.length > 0 ? `
                            <div class="answers-list">
                                ${q.answers.map(ans => {
                                    const letter = String.fromCharCode(65 + ans.index);
                                    const isCorrect = ans.is_correct ? 'correct' : '';
                                    return `
                                        <div class="answer-option ${isCorrect}">
                                            <span class="answer-letter">${letter}</span>
                                            <span class="answer-text">${ans.text}</span>
                                        </div>
                                    `;
                                }).join('')}
                            </div>
                            <div class="answer-selector">
                                <label>Đáp án của bạn:</label>
                                <div class="btn-group">
                                    ${['A', 'B', 'C', 'D'].slice(0, q.answers.length).map((letter, idx) => {
                                        const active = letter === correctLetter ? 'active' : '';
                                        return `<button type="button" class="btn-answer ${active}" onclick="selectAnswer(${index}, ${idx})">${letter}</button>`;
                                    }).join('')}
                                </div>
                            </div>
                        ` : ''}
                        
                        ${q.giai_thich ? `
                            <div style="margin-left: 75px; margin-top: 15px; padding: 10px; background: #fef3c7; border-left: 3px solid #f59e0b; border-radius: 4px;">
                                <small style="color: #92400e;"><strong>Giải thích:</strong> ${q.giai_thich}</small>
                            </div>
                        ` : ''}
                    </div>
                `;
            });

            document.getElementById('questionsList').innerHTML = html;
            document.getElementById('previewArea').style.display = 'block';

            // Render MathJax cho preview
            setTimeout(() => {
                if (window.MathJax && window.MathJax.typesetPromise) {
                    MathJax.typesetPromise().catch((err) => console.log('MathJax error:', err));
                }
            }, 100);

            // Scroll to preview
            document.getElementById('previewArea').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }

        // Select answer
        function selectAnswer(questionIndex, answerIndex) {
            const questionDiv = document.querySelector(`[data-index="${questionIndex}"]`);
            const buttons = questionDiv.querySelectorAll('.btn-answer');
            const answers = questionDiv.querySelectorAll('.answer-option');

            buttons.forEach(btn => btn.classList.remove('active'));
            answers.forEach(ans => ans.classList.remove('correct'));

            buttons[answerIndex].classList.add('active');
            answers[answerIndex].classList.add('correct');

            if (previewData && previewData.questions[questionIndex]) {
                previewData.questions[questionIndex].answers.forEach((ans, idx) => {
                    ans.is_correct = idx === answerIndex;
                });
            }
        }

        // Select all checkbox
        document.getElementById('selectAll').addEventListener('change', function() {
            const checked = this.checked;
            document.querySelectorAll('.question-checkbox').forEach(cb => {
                cb.checked = checked;
                cb.closest('.question-preview').classList.toggle('selected', checked);
            });
        });

        // Individual checkbox
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('question-checkbox')) {
                const preview = e.target.closest('.question-preview');
                preview.classList.toggle('selected', e.target.checked);

                const total = document.querySelectorAll('.question-checkbox').length;
                const checked = document.querySelectorAll('.question-checkbox:checked').length;
                document.getElementById('selectAll').checked = total === checked;
            }
        });

        // Import confirmed
        document.getElementById('btnImport').addEventListener('click', function() {
            const selectedIndexes = [];
            document.querySelectorAll('.question-checkbox:checked').forEach(cb => {
                selectedIndexes.push(parseInt(cb.dataset.index));
            });

            if (selectedIndexes.length === 0) {
                Swal.fire('Lỗi', 'Vui lòng chọn ít nhất 1 câu hỏi để import', 'warning');
                return;
            }

            Swal.fire({
                title: 'Xác nhận import',
                text: `Bạn có chắc muốn import ${selectedIndexes.length} câu hỏi vào hệ thống?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Có, import ngay',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#4f46e5'
            }).then((result) => {
                if (result.isConfirmed) {
                    performImport(selectedIndexes);
                }
            });
        });

        function performImport(selectedIndexes) {
            Swal.fire({
                title: 'Đang import...',
                text: `Đang xử lý ${selectedIndexes.length} câu hỏi`,
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            const formData = new FormData();
            formData.append('_token', '{{ csrf_token() }}');
            formData.append('chuong_hoc_id', document.getElementById('file_chuong_hoc_id').value);
            formData.append('loai_cau_hoi', document.querySelector('#file-form [name="loai_cau_hoi"]').value);
            formData.append('muc_do', document.querySelector('#file-form [name="muc_do"]').value);
            formData.append('temp_file', tempFile);

            selectedIndexes.forEach(index => {
                formData.append('selected_questions[]', index);
            });

            fetch('{{ route('admin.cauhoi.import.word.confirmed') }}', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json',
                    },
                    body: formData
                })
                .then(async response => {
                    const responseText = await response.text();
                    if (!response.ok) {
                        throw new Error(`Server error ${response.status}`);
                    }
                    return JSON.parse(responseText);
                })
                .then(data => {
                    Swal.close();
                    if (data.success) {
                        Swal.fire({
                            title: 'Thành công!',
                            text: data.message,
                            icon: 'success',
                            confirmButtonColor: '#4f46e5'
                        }).then(() => {
                            if (data.redirect) {
                                window.location.href = data.redirect;
                            }
                        });
                    } else {
                        Swal.fire('Lỗi', data.message || 'Có lỗi xảy ra', 'error');
                    }
                })
                .catch(error => {
                    Swal.close();
                    console.error('Import error:', error);
                    Swal.fire('Lỗi', 'Có lỗi xảy ra khi import: ' + error.message, 'error');
                });
        }

        // Cancel
        document.getElementById('btnCancel').addEventListener('click', function() {
            document.getElementById('previewArea').style.display = 'none';
            document.getElementById('uploadForm').reset();
            document.getElementById('fileLabel').textContent = 'Click để chọn file Word (.docx)';
            previewData = null;
            tempFile = null;
        });

        function switchTab(type) {
            document.getElementById('manual-form').style.display = type === 'manual' ? 'block' : 'none';
            document.getElementById('file-form').style.display = type === 'file' ? 'block' : 'none';
            document.getElementById('tab-manual').classList.toggle('active', type === 'manual');
            document.getElementById('tab-file').classList.toggle('active', type === 'file');
        }

        window.onload = () => {
            initEditors();
            for (let i = 0; i < 4; i++) addAnswer();
            document.getElementById('mon_hoc_id').dispatchEvent(new Event('change'));
        };
        // Lọc bài học theo chương học
        document.getElementById('chuong_hoc_id').addEventListener('change', function() {
            const chuongId = this.value;
            const baiHocSelect = document.getElementById('bai_hoc_id');
            
            baiHocSelect.querySelectorAll('option').forEach(opt => {
                // Luôn hiện dòng option rỗng "-- Dùng chung --"
                if (opt.value === "") {
                    opt.style.display = "block";
                } else {
                    // Chỉ hiện các bài học thuộc chương đã chọn
                    opt.style.display = (opt.getAttribute('data-chuong') == chuongId) ? "block" : "none";
                }
            });
            // Reset giá trị bài học về mặc định khi đổi chương
            baiHocSelect.value = "";
        });
    </script>
@endsection
